<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>LocoSwap.Language</RootNamespace>
    <AssemblyName>LocoSwap.Language</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Update="Resources\Resources.resx" Generator="PublicResXFileCodeGenerator" LastGenOutput="Resources.Designer.cs" />
    <EmbeddedResource Update="Resources\Resources.de.resx" CustomToolNamespace="LocoSwap.Language" />
    <EmbeddedResource Update="Resources\Resources.fr.resx" />
    <EmbeddedResource Update="Resources\Resources.it.resx" CustomToolNamespace="LocoSwap.Language" />
    <EmbeddedResource Update="Resources\Resources.nl.resx" />
    <EmbeddedResource Update="Resources\Resources.ru.resx" CustomToolNamespace="LocoSwap.Language" />
  </ItemGroup>
</Project>
